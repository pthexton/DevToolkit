<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.beyondtrust.devtoolkit</string>

    <!-- Path relative to the app bundle; resolved wherever the .app lives. -->
    <key>BundleProgram</key>
    <string>Contents/MacOS/DevToolkitApp</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- Marks the launchd-managed (canonical) instance so a user double-click
         can hand off to it instead of running a second copy. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>DEVTOOLKIT_LAUNCHD</key>
        <string>1</string>
    </dict>

    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.beyondtrust.devtoolkit</string>
    </array>
</dict>
</plist>
