<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>DevToolkit</string>
    <key>CFBundleDisplayName</key>
    <string>DevToolkit</string>
    <key>CFBundleIdentifier</key>
    <string>com.beyondtrust.devtoolkit</string>
    <key>CFBundleExecutable</key>
    <string>DevToolkitApp</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Menu-bar accessory: no Dock icon, never the active app except while the overlay is showing. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSAppleEventsUsageDescription</key>
    <string>DevToolkit uses Apple Events to find and switch to the exact browser tab or terminal tab you search for (Safari, Chrome, iTerm2, Ghostty, Terminal).</string>
</dict>
</plist>
